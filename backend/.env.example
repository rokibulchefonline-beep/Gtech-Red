# LOCAL DEVELOPMENT (Laravel Herd). Copy to .env, then run: php artisan key:generate
# Only this template is committed. The real .env holds secrets and stays on your machine (it is gitignored).
# For the live server use .env.production.example instead.

APP_NAME="GTech Digital Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gtech.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gtech
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync: emails (password reset, lead alerts) are sent straight away, no queue worker needed.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Emails are written to storage/logs/laravel.log instead of being sent.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# GTech website
# Any long random string locally. Must match the website's LARAVEL_API_TOKEN.
GTECH_API_TOKEN=
# false: pages are marked noindex, so a local or test copy never gets into Google.
GTECH_BLADE_LIVE=false
GTECH_SITE_URL=http://gtech.test
GTECH_PUBLIC_URL=http://gtech.test
# Page cache off while developing, so changes show immediately.
GTECH_PAGE_CACHE=false

# Laravel AI SDK (config/ai.php). Leave empty unless you are testing AI features.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: full path to ffmpeg, so uploaded hero videos are compressed automatically (leave empty if ffmpeg is on the PATH).
FFMPEG_PATH=
