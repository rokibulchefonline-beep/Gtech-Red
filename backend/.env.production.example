# LIVE SERVER. Copy to .env on the server (not into the repo), fill in the blanks, then run:
#   php artisan key:generate     (first install only; never change APP_KEY afterwards)
#   php artisan config:cache
# Only this template is committed. Every value marked "secret" belongs in the server's .env only.

APP_NAME="GTech Digital Admin"
APP_ENV=production
# secret: generated once by key:generate. Changing it logs everyone out and breaks encrypted settings.
APP_KEY=
# Never true on the live site: it shows code, paths and settings to visitors when an error happens.
APP_DEBUG=false
APP_URL=https://www.gtechdigital.co.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# One log file per day, kept for 14 days; only warnings and errors.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gtech
DB_USERNAME=gtech
# secret
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync works everywhere. Switch to 'database' only if a queue worker runs (php artisan queue:work via Supervisor or cron).
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Real email sending (your mail provider's SMTP details).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
# secret
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@gtechdigital.co.uk"
MAIL_FROM_NAME="GTech Digital"

VITE_APP_NAME="${APP_NAME}"

# true: this is the live website and search engines may index it. Set false on a staging copy.
GTECH_BLADE_LIVE=true
GTECH_SITE_URL=https://www.gtechdigital.co.uk
GTECH_PUBLIC_URL=https://www.gtechdigital.co.uk
GTECH_PAGE_CACHE=true
GTECH_PAGE_CACHE_TTL=43200

# Laravel AI SDK (config/ai.php)
AI_PROVIDER=anthropic
# secret: only the key for the provider you use.
ANTHROPIC_API_KEY=

# Optional: full path to ffmpeg, so uploaded hero videos are compressed automatically (leave empty if ffmpeg is on the PATH).
FFMPEG_PATH=
