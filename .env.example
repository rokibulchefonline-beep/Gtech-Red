# Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB=gtech_red
NEXT_PUBLIC_HERO_VIDEO_URL=

# --- Admin panel (/admin) ---
# Long random string used to sign login sessions and encrypt the SMTP password. Required in production.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=
# Optional: if set, the one-time /admin/setup page asks for this key before creating the first super admin.
SETUP_KEY=
# Optional: Cloudflare (or other) deploy hook URL for the "Publish site" button. Can also be set in Admin > Settings.
DEPLOY_HOOK_URL=
